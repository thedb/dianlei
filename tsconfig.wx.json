{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist-wx",
    "declaration": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    // Locked ship frames are default-imported JSON. CommonJS rejects that
    // unless this flag is on. It only affects typechecking, not emit.
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/platform/wx.ts", "src/engine/**/*", "src/game/**/*"],
  "exclude": ["src/platform/h5.ts", "src/main.ts"]
}
